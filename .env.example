# =============================================================================
# TCGMASTER — variables de entorno de ejemplo
# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` a Git.
# =============================================================================

# ---- General ----
APP_ENV=development              # development | production | loadtest
APP_NAME=TCGMASTER
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | console
PUBLIC_BASE_URL=http://localhost:8080   # URL pública del sitio (usada en return_url de pagos)

# ---- Base de datos (PostgreSQL) ----
POSTGRES_DB=tcgmaster
POSTGRES_USER=tcgmaster
POSTGRES_PASSWORD=cambia_esto
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_SIZE=10                  # conexiones por proceso worker
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# ---- Backend (FastAPI + Gunicorn/Uvicorn) ----
API_WORKERS=2                    # procesos worker; variable clave en pruebas de carga
API_PORT=8000
API_PAGE_SIZE_DEFAULT=24
API_PAGE_SIZE_MAX=60             # tope de paginación impuesto por el servidor
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Autenticación ----
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_MINUTES=120
PASSWORD_HASH_ROUNDS=10          # costo del hash; impacta CPU en login/registro bajo carga

# ---- Pagos (sandbox; nunca credenciales reales) ----
PAYMENT_PROVIDER=webpay          # webpay | mock  (mock = simulación local para pruebas de carga)
# Credenciales públicas del ambiente de INTEGRACIÓN de Transbank (documentación oficial).
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# ---- Analítica (GA4) ----
VITE_GA4_MEASUREMENT_ID=         # ej: G-XXXXXXXXXX; vacío = analítica desactivada
VITE_TRAFFIC_TYPE=real           # real | load_test
VITE_API_BASE_URL=/api

# ---- Límites de recursos de Docker Compose (reproducibilidad de pruebas) ----
API_CPUS=1.0
API_MEMORY=512m
DB_CPUS=1.0
DB_MEMORY=512m
WEB_CPUS=0.5
WEB_MEMORY=128m

# ---- Script de datos semilla ----
SEED_RANDOM_SEED=8091            # semilla fija: mismo catálogo en cada ejecución
SEED_CARDS_PER_GAME=150          # 3 juegos x 150 = 450 cartas
SEED_HTTP_DELAY_MS=120           # pausa entre peticiones a las APIs públicas
POKEMONTCG_API_KEY=              # opcional; sube el límite de la Pokémon TCG API
