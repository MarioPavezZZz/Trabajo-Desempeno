# =============================================================================
# TCGMASTER — variables de PRODUCCIÓN (plantilla).
# scripts/deploy.sh crea el .env del servidor a partir de este archivo la
# primera vez y reemplaza los valores GENERAR_* por secretos aleatorios.
# Comentarios siempre en línea aparte (Docker Compose toma un comentario en la
# misma línea de una variable vacía como si fuera su valor).
# =============================================================================

# ---- Sitio ----
SITE_DOMAIN=tcgmaster.chilecentral.cloudapp.azure.com
PUBLIC_BASE_URL=https://tcgmaster.chilecentral.cloudapp.azure.com
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=https://tcgmaster.chilecentral.cloudapp.azure.com

# ---- Puertos internos: solo en la interfaz local del servidor ----
WEB_PORT=127.0.0.1:8080
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# ---- Base de datos ----
POSTGRES_DB=tcgmaster
POSTGRES_USER=tcgmaster
POSTGRES_PASSWORD=GENERAR_CLAVE_BD
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# ---- API ----
API_WORKERS=2
API_PAGE_SIZE_DEFAULT=24
API_PAGE_SIZE_MAX=60
API_CACHE_MAX_AGE=0
API_DOCS_ENABLED=false

# ---- Autenticación ----
JWT_SECRET=GENERAR_JWT
JWT_EXPIRES_MINUTES=120
PASSWORD_HASH_ROUNDS=10
COOKIE_SECURE=true

# ---- Pagos: Webpay Plus de INTEGRACIÓN (credenciales públicas de prueba) ----
PAYMENT_PROVIDER=webpay
LOAD_TEST_USE_MOCK=true
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
RESERVATION_MINUTES=15
MOCK_PAYMENT_LATENCY_MS=300
MOCK_APPROVAL_RATE=0.9
SHIPPING_HOME_CLP=3990

# ---- Frontend / GA4 ----
VITE_GA4_MEASUREMENT_ID=G-2RNCWE4525
VITE_ANALYTICS_DEBUG=false
VITE_TRAFFIC_TYPE=real
VITE_API_BASE_URL=/api
# Ambiente de prueba del curso: botón "Usar datos de prueba" visible.
VITE_TEST_HELPERS=true

# ---- Límites de recursos (mismos que en local, para comparar mediciones) ----
API_CPUS=1.0
API_MEMORY=512m
DB_CPUS=1.0
DB_MEMORY=512m
WEB_CPUS=0.5
WEB_MEMORY=128m
CADDY_CPUS=0.5
CADDY_MEMORY=128m

# ---- Datos semilla ----
DATA_DIR=/data
SEED_RANDOM_SEED=8091
SEED_CARDS_PER_GAME=150
SEED_BASE_DATE=2026-11-01
SEED_USD_CLP=950
SEED_HTTP_DELAY_MS=120
